{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local-dns"
      },
      {
        "type": "https",
        "tag": "direct-dns",
        "server": "223.5.5.5"
      },
      {
        "type": "udp",
        "tag": "direct-dns-bootstrap",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "proxy-dns",
        "server": "8.8.8.8",
        "detour": "proxy"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-private",
        "server": "local-dns"
      },
      {
        "clash_mode": "Direct",
        "server": "direct-dns"
      },
      {
        "clash_mode": "Global",
        "server": "proxy-dns"
      },
      {
        "rule_set": "category-ads-all",
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "predefined"
      },
      {
        "rule_set": [
          "geosite-cn",
          "microsoft",
          "onedrive",
          "apple"
        ],
        "server": "direct-dns"
      },
      {
        "rule_set": "geolocation-!cn",
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "evaluate",
        "server": "proxy-dns",
        "tag": "proxy-probe",
        "timeout": "3s"
      },
      {
        "match_response": "proxy-probe",
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": "proxy-probe",
        "response_rcode": "NXDOMAIN",
        "action": "respond"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "direct-dns"
      }
    ],
    "final": "proxy-dns",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "hysteria2"
      ]
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2",
      "server": "example.com",
      "server_port": 443,
      "password": "CHANGE_ME",
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "insecure": true
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_cidr": [
          "198.18.0.0/15",
          "fc00::/18"
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "proxy"
      },
      {
        "rule_set": "category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-cn",
          "microsoft",
          "onedrive",
          "apple"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": "geolocation-!cn",
        "outbound": "proxy"
      },
      {
        "action": "resolve"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "category-ads-all",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs"
      },
      {
        "type": "remote",
        "tag": "geolocation-!cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "microsoft",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft.srs"
      },
      {
        "type": "remote",
        "tag": "onedrive",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/onedrive.srs"
      },
      {
        "type": "remote",
        "tag": "apple",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple.srs"
      }
    ],
    "final": "proxy",
    "default_domain_resolver": "direct-dns",
    "default_http_client": "rule-set-direct"
  },
  "experimental": {
    "clash_api": {
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "cache_id": "ios-fakeip",
      "store_fakeip": true,
      "store_dns": true
    }
  },
  "http_clients": [
    {
      "tag": "rule-set-direct",
      "domain_resolver": "direct-dns-bootstrap"
    }
  ]
}
